{
  "name": "next-creators-video",
  "version": "1.0.0",
  "private": true,
  "description": "Reel Next Creators \u2014 audiovisual para empresas (Remotion)",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render NextCreatorsReel out/next-creators-reel.mp4",
    "still": "remotion still NextCreatorsReel out/preview.png --frame=60",
    "render:v2": "remotion render NextCreatorsReelV2 out/next-creators-reel-v2.mp4",
    "trilha": "python3 scripts/trilha.py",
    "render:baloes": "remotion render BaloesHolograficos out/baloes-holograficos.mp4"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.540",
    "@remotion/fonts": "^4.0.540",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remotion": "^4.0.540"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
